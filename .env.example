# Supabase Auth (Google) — Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server DB writes — set ONE of these (never commit secrets):
# A) Postgres URI (Settings → Database), or
# B) Service role key (Settings → API) — enough for M1 without DATABASE_URL
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter — ONLY AI key (Claude / GPT / Gemini all via OpenRouter). Server-only.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=VibeWork
OPENROUTER_APP_URL=http://localhost:3000

# Optional per-job OpenRouter model overrides (see lib/ai/config.ts)
# AI_MODEL_SCREEN=anthropic/claude-haiku-4.5
# AI_MODEL_PLAN=anthropic/claude-sonnet-4.5
# AI_MODEL_REPAIR=anthropic/claude-sonnet-4.5
# AI_MODEL_AUDIT=anthropic/claude-sonnet-4.5

# Inngest — optional for M1. If unset, generation runs via Next.js after().
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# INNGEST_DEV=1

# Sentry / PostHog — optional
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
